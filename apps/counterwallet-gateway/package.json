{
  "name": "counterwallet-gateway",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/gateway.test.js",
    "typecheck": "tsc --noEmit",
    "build:pages": "wrangler pages functions build functions --project-directory . --outdir .wrangler/pages-build",
    "check": "npm run typecheck && npm test && npm run build:pages",
    "deploy:pages": "wrangler pages deploy public --project-name counterwallet-api"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "typescript": "^5.7.0",
    "wrangler": "4.125.0"
  }
}
