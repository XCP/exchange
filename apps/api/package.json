{
  "name": "xcpdex-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "typegen": "wrangler types --include-runtime false",
    "types:check": "wrangler types --include-runtime false --check",
    "lint:promises": "oxlint --deny typescript/no-floating-promises src/",
    "test": "tsc -p tsconfig.test.json && node scripts/run-compiled-tests.mjs && node scripts/test-replay-migration.mjs && vitest run --config vitest.config.mts",
    "reconcile": "node scripts/reconcile.mjs",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply xcpdex --local",
    "migrate:remote": "wrangler d1 migrations apply xcpdex --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "oxlint": "1.82.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "4.129.1"
  },
  "dependencies": {
    "hono": "^4.13.3"
  }
}
