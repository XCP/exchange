{
  "name": "xcpdex-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "test": "tsc -p tsconfig.test.json && node scripts/run-compiled-tests.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply xcpdex --local",
    "migrate:remote": "wrangler d1 migrations apply xcpdex --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "typescript": "^5.7.0",
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.0.0",
    "@scure/btc-signer": "^2.0.1",
    "hono": "^4.13.3"
  }
}
